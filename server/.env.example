PORT=3000
FIREBASE_PROJECT_ID=proxy-health-data
# FIRESTORE_DATABASE_ID=(default)
# Bearer tokens for the iOS app and MCP clients: token:userId[,token:userId]
# Generate one with: openssl rand -hex 24
API_TOKENS=change-me:me
# Optional: inline service-account JSON. Otherwise Application Default Credentials are used.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
